{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#8caaee",
          "template": "{{ .Path }}",
          "properties": {
            "style": "short"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#8caaee",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#e5c890{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ef9f76{{ end }}",
            "{{ if gt .Ahead 0 }}#8caaee{{ end }}",
            "{{ if gt .Behind 0 }}#ef9f76{{ end }}"
          ],
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} *{{ end }}{{ if .Staging.Changed }} +{{ end }}",
          "properties": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#838ba7",
          "template": "{{ .FormattedMs }}",
          "properties": {
            "threshold": 500,
            "style": "roundrock"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#c6d0f5",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#e78284{{ end }}"
          ],
          "template": "{{ if gt .Code 0 }}✗{{ else }}❯{{ end }} "
        }
      ]
    }
  ]
}
